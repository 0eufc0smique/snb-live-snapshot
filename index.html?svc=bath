            <svg viewBox="0 0 120 46"><path d="M6 6 C 30 40, 70 44, 112 30 M100 22 L112 30 L100 38" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
